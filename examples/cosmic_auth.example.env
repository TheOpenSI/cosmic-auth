### BFF Framework ###
AUTH_PUBLIC_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5173


### CoSMIC session ###
SESSION_COOKIE_NAME=cosmic_session
SESSION_MAX_AGE=900
# How long does the session cookie persists so that `/api/v1/auth/refresh` can
# still read the valid JWT token until expired.
SESSION_REFRESH_TOKEN_MAX_AGE=86400
SESSION_ISSUER=cosmic-auth
# Static RSA key-pair used to sign/verify the issued CoSMIC JWT session cookie
# using RS256 encryption algorithm. The private key never leaves the auth
# micro-service, while the public one is published at `/api/v1/auth/jwks.json`
# so that other micro-services can discover it. If you don't get any of this yet,
# just leave empty so default PEM files get used (generated by running setup
# script under `bins/` directory)
SESSION_PRIVATE_KEY_PATH=
SESSION_PUBLIC_KEY_PATH=
# Optional explicit key id according to RFC 7638 thumbprint of the key
SESSION_KEY_ID=


### Starlette SessionMiddleware (holds temporary Authlib OAuth state/nonce) ###
SESSION_SECRET=019fd556-7e24-7722-911a-0de7345cd6c2
SESSION_OAUTH_COOKIE=cosmic_oauth_session


### Keycloak (Google & Microsoft IdPs are integrated by default) ###
KEYCLOAK_INTERNAL_URL=http://cosmic-keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=cosmic
KEYCLOAK_CLIENT_ID=cosmic-fastapi-keycloak
KEYCLOAK_CLIENT_SECRET=019fa63f-1377-7cb1-b433-784b0de5b05e
