# ── Shared BFF ────────────────────────────────────────────────
AUTH_PUBLIC_URL=http://localhost:8081
FRONTEND_URL=http://localhost:5173

# ── Cosmic session (app-issued JWT, RS256) ────────────────────
SESSION_COOKIE_NAME=cosmic_session
SESSION_MAX_AGE=900
REFRESH_TOKEN_MAX_AGE=86400
SESSION_ISSUER=cosmic-auth
# Leave blank to use the default auth/secrets/*.pem paths.
SESSION_PRIVATE_KEY_PATH=
SESSION_PUBLIC_KEY_PATH=
SESSION_KEY_ID=

# ── Authlib OAuth state/nonce cookie ──────────────────────────
SESSION_SECRET=019fd556-7e24-7722-911a-0de7345cd6c2
OAUTH_SESSION_COOKIE=cosmic_oauth_session

# ── Keycloak (the only IdP the BFF talks to) ──────────────────
KEYCLOAK_INTERNAL_URL=http://cosmic-keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=cosmic
KEYCLOAK_CLIENT_ID=cosmic-fastapi-keycloak
KEYCLOAK_CLIENT_SECRET=019fa63f-1377-7cb1-b433-784b0de5b05e
