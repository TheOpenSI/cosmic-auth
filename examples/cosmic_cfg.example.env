# NOTE:
# This repository does not run PostgreSQL. It attaches to the database of
# `cosmic-db` over the shared `cosmic_net` network, so the values below must
# describe that same database. `DB_USER`, `DB_PASSWORD` and `DB_NAME` are
# reconciled by `bins/setup.ps1` / `bins/setup.sh` from `docker/secrets/postgres_*.txt`
# (the credential files the database container itself reads). Change the secrets
# there instead of these three values, and keep them in sync with `cosmic-db`.

## Docker setup
DB_DIALECT=postgresql
DB_DRIVER=psycopg
DB_USER=demo
DB_PASSWORD=demo123
DB_HOST=database
DB_PORT=5432
DB_NAME=demo

# Set your OpenAI API key here
OPENAI_API_KEY=


## Native setup
# DB_DIALECT=postgresql
# DB_DRIVER=psycopg
# DB_USER=postgres
# DB_PASSWORD=postgres123
# DB_HOST=localhost # Or IP address
# DB_PORT=5432
# DB_NAME=postgres
#
# # Set your OpenAI API key here
# OPENAI_API_KEY=
