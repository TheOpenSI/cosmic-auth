# NOTE:
# This repo does not have its own PostgreSQL database (it should be, but not at
# the time this commit get push). Rather, it attaches to the database in
# `cosmic-db` repo over the shared `cosmic_net` network, so the values below must
# describe that same database. `DB_USER`, `DB_PASSWORD` and `DB_NAME` are
# reconciled by `bins/setup.ps1` (Windows) or `bins/setup.sh` (Linux/MacOS).


## Docker setup
DB_DIALECT=postgresql
DB_DRIVER=psycopg
DB_USER=demo
DB_PASSWORD=demo123
DB_HOST=database
DB_PORT=5432
DB_NAME=demo

# Set your OpenAI API key here
OPENAI_API_KEY=


## Native setup
# DB_DIALECT=postgresql
# DB_DRIVER=psycopg
# DB_USER=postgres
# DB_PASSWORD=postgres123
# DB_HOST=localhost # Or IP address
# DB_PORT=5432
# DB_NAME=postgres
#
