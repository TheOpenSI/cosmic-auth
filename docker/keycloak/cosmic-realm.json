{
  "realm": "cosmic",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "verifyEmail" : true,
  "smtpServer": {
    "host": "smtp.gmail.com",
    "port": 587,
    "from": "${KEYCLOAK_SMTP_USER}",
    "fromDisplayName": "CoSMIC",
    "replyTo  ": "",
    "starttls": "true",
    "auth": "true",
    "user": "${KEYCLOAK_SMTP_USER}",
    "password": "${KEYCLOAK_SMTP_PWD}",
    "ssl": "false"

  },
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "user" }
    ]
  },
  "clients": [
    {
      "clientId": "cosmic-fastapi-keycloak",
      "name": "CoSMIC fastapi-keycloak",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "redirectUris": ["http://localhost:8081/api/v1/auth/callback/keycloak"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8081"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "cosmic",
      "email": "${KEYCLOAK_TEST_USER_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "OpenSI",
      "lastName": "cosmic",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
